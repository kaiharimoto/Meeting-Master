# Meeting Master — home AI server configuration
# Copy to server/server.env (git-ignored) and fill in real values.

# Shared secret — must match BEARER_TOKEN in the laptop app's laptop.env.
BEARER_TOKEN=change-me-to-a-long-random-string

# Where job data (audio, transcripts, PDFs) is stored.
DATA_DIR=./data

# --- Audio normalization ---
FFMPEG_PATH=ffmpeg

# --- Transcription (whisper.cpp built with -DGGML_VULKAN=ON) ---
WHISPER_CLI=C:\tools\whisper.cpp\build\bin\Release\whisper-cli.exe
WHISPER_MODEL_DIR=C:\tools\whisper.cpp\models
WHISPER_MODEL_DEFAULT=large-v3-turbo
WHISPER_MODEL_FALLBACK=large-v3
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_SEC=3600
# Tokens of PREVIOUS transcript carried into the next window. 0 disables it and
# is the default: carry-over is what turns a quiet stretch into "I don't know."
# repeated for pages, because the phrase lands in the prompt for the next window
# and makes itself likelier. Set -1 for whisper.cpp's own behaviour.
WHISPER_MAX_CONTEXT=0
# Extra whisper-cli flags, appended verbatim (e.g. "-et 2.8 -lpt -0.5").
WHISPER_EXTRA_ARGS=

# --- Which model writes the notes ---
# "ollama" (default) or "claude_cli".
#
# Ollama runs here, needs no account, no internet and no sign-in that can
# lapse — the premise of a self-hosted pipeline, and the reason it stays the
# default and the fallback. "claude_cli" shells out to the Claude Code CLI on
# this machine instead, signed in once with `claude login` against an existing
# subscription (no API key, no per-token billing). It exists because the
# operator's WORK network blocks AI services while this machine's does not, so
# the home PC can do the round trip that otherwise means retyping a prompt on
# a phone.
#
# Two things to know before switching: subscription plans have usage limits a
# long meeting can hit, and the sign-in has to keep working on this machine.
# Either way the transcript is already safe — switch back to Ollama and press
# Start AI again.
AI_PROVIDER=ollama
# Blank = find it on PATH, then the usual install locations. Set this when the
# service's PATH differs from the desktop session that installed it (on
# Windows it usually does).
CLAUDE_CLI_PATH=
# Blank = whatever the CLI is configured to use.
CLAUDE_MODEL=
# A whole-meeting summary is one long call; waiting costs less than giving up
# on a finished meeting.
CLAUDE_CLI_TIMEOUT_SEC=900

# --- Summarization + Q&A extraction (Ollama running natively on Windows) ---
# Everything below this line configures OLLAMA. With AI_PROVIDER=claude_cli
# these are ignored (Claude's context is large enough that the chunking these
# sizes drive is skipped entirely).
OLLAMA_URL=http://127.0.0.1:11434
# Gemma 4 26B (MoE, ~3.8B active) — fast on a 24 GB RX 7900 XTX and leaves
# headroom for the 32K context. Pull it with:  ollama pull gemma4:26b
OLLAMA_MODEL=gemma4:26b
# Context window for the native /api/chat call. Must comfortably exceed
# transcript + prompt + output tokens or the transcript gets truncated.
NUM_CTX=32768
# Reserved output tokens for the structured summary (Key Takeaways / Key
# Insights / Decisions / Action Items / Key Figures / Topics).
SUMMARY_NUM_PREDICT=1400
SUMMARY_TEMPERATURE=0.3
# Reserved output tokens + temperature for Q&A extraction (JSON list).
EXTRACT_NUM_PREDICT=1500
EXTRACT_TEMPERATURE=0.2
# Turn a reasoning model's thinking off for these calls. Every stage wants
# strict JSON on a small output budget, and a thinking model spends the budget
# reasoning instead — which looks like "the summary failed". Sent only to models
# that advertise the capability, so it is safe to leave on.
OLLAMA_DISABLE_THINKING=true

# --- Mid-meeting live suggestions (POST /live/questions) ---
# Questions the AI hears being answered, plus key insights, offered to the
# note-taker in the laptop's side rail while the meeting runs. The laptop reads
# these off GET /live/config, so this is the only place they are configured.
LIVE_SUGGESTIONS=true
# Blank = use OLLAMA_MODEL. Name a SMALLER installed model when the summary
# model can't answer inside a meeting: an answer that arrives after the
# conversation moved on is worse than no answer.
LIVE_MODEL=
# How often the laptop asks, and how much recent transcript it sends.
LIVE_INTERVAL_SEC=45
LIVE_WINDOW_CHARS=4000
# Server-side budget for one ask. The laptop waits LONGER than this (it derives
# its own timeout from it), so it can never abandon a request still being
# worked on.
LIVE_TIMEOUT_SEC=90
# Keep the live model resident in VRAM between asks — a cold load is the usual
# reason a mid-meeting ask blows its budget. 0 disables.
LIVE_KEEP_ALIVE_MIN=30
# Reserved output tokens per ask.
LIVE_EXTRACT_NUM_PREDICT=600

# --- Email (Gmail SMTP with an App Password, sent from this machine) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=you@gmail.com
# A Google App Password (NOT your account password): https://myaccount.google.com/apppasswords
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=you@gmail.com

# Preset recipients + email template (copy the *.example files in ../config).
RECIPIENTS_PATH=../config/recipients.json
EMAIL_TEMPLATE_PATH=../config/email_template.txt
