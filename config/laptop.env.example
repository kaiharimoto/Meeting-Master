# Meeting Master — laptop app configuration
#
# Copy this file to laptop.env inside the app's user-data directory
# (the app shows the exact path under Settings, e.g.
# C:\Users\<you>\AppData\Roaming\MeetingMaster\laptop.env).
# In development you can keep a laptop.env next to app/package.json.

# Home AI server (Tailscale HTTPS URL from `tailscale serve --bg 8080`,
# or a LAN address like http://192.168.1.50:8080 while testing).
HOME_SERVER_URL=https://homepc.tail-xxxx.ts.net

# Shared secret — must match BEARER_TOKEN in the home server's server.env.
BEARER_TOKEN=change-me-to-a-long-random-string

# Where the finished PDF is emailed from:
#   home   = the home server sends it (default; keeps Gmail credentials off
#            this laptop and works even if this network blocks SMTP)
#   laptop = this app sends it directly via Gmail SMTP (needs the SMTP_*
#            values below and a network that allows outbound 465)
EMAIL_MODE=home

# PDF page size: Letter or A4
PAGE_SIZE=Letter

# Only used when EMAIL_MODE=laptop:
SMTP_USER=you@gmail.com
# A Google App Password (NOT your account password): https://myaccount.google.com/apppasswords
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
