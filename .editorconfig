# Meeting Master — editor settings (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python uses 4-space indentation (PEP 8).
[*.py]
indent_size = 4

# Trailing whitespace is significant in Markdown (two-space line breaks).
[*.md]
trim_trailing_whitespace = false
